# Copy this file to .env and fill in your real values.
# Never commit the real .env file — it holds secret keys.

PORT=3000

# ---- AI chat (OpenRouter) ----
OPENROUTER_API_KEY=

# ---- 👑 Premium: Razorpay (India) ----
# From https://dashboard.razorpay.com/app/keys
# RAZORPAY_KEY_ID is public-ish (sent to the browser to open the checkout
# widget); RAZORPAY_KEY_SECRET must stay server-side only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- 👑 Premium: PayPal (rest of world) ----
# From https://developer.paypal.com/dashboard/applications  (create a
# "Live" app for real charges, or use the default "Sandbox" app to test
# with fake money first — set PAYPAL_MODE accordingly).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# PAYPAL_MODE=live

# ---- 👑 Premium: pricing (optional overrides) ----
# All values are in the smallest currency unit (paise / cents).
# Defaults if unset: Level 1 (60-Day Pass) = ₹149 / $2.99
#                     Level 2 (Lifetime)   = ₹999 / $14.99
# PREMIUM_L1_PRICE_INR_PAISE=14900
# PREMIUM_L1_PRICE_USD_CENTS=299
# PREMIUM_L2_PRICE_INR_PAISE=99900
# PREMIUM_L2_PRICE_USD_CENTS=1499
